# ─── Blynk ─────────────────────────────────────────────────────────────────────
# Auth token from your Blynk Console (Devices → My Device → Device Info).
# In Netlify, also set BLYNK_TOKEN with the SAME value (used by the function).
VITE_BLYNK_TOKEN=

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Supabase project URL and anon (publishable) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── EmailJS (https://www.emailjs.com) — over-voltage alert email ─────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Recipient address that receives the alert.
VITE_ALERT_EMAIL_TO=
